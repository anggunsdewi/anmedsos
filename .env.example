# Salin menjadi .env lalu isi. Jangan unggah .env ke repositori.
X_BEARER_TOKEN=
# String acak panjang dan rahasia, sama untuk seluruh anggota tim agar user_hash konsisten.
# Contoh membuatnya: python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_SALT=
# Threads: access token pengguna (long-lived, berlaku 60 hari) dari aplikasi Meta dengan izin threads_keyword_search.
THREADS_ACCESS_TOKEN=
# TikTok via Apify: API token dari https://console.apify.com/settings/integrations
APIFY_TOKEN=
